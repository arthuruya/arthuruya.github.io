---
/**
 * Case-study page (RENCANA Phase 6): title, dek, role, period, stack and links; then
 * problem, constraints, decision, result and (when present) change; the NOC diagram on
 * monitoring-noc; the facts strip; back to home and the next case study.
 */
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import LangSwitch from '../components/LangSwitch.astro';
import LinkArrow from '../components/LinkArrow.astro';
import NocDiagram from '../components/NocDiagram.astro';
import Section from '../components/Section.astro';
import SkipLink from '../components/SkipLink.astro';
import Stat from '../components/Stat.astro';
import Tag from '../components/Tag.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import type { Accent, Lang } from '../components/types';
import { t } from '../i18n/index.ts';
import { getCaseStudies, getSite } from '../lib/content.ts';
import { homePath, otherLang, workPath, type CaseStudySlug } from '../lib/routes.ts';

export interface Props {
  lang: Lang;
  slug: CaseStudySlug;
}

const { lang, slug } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
const site = await getSite(lang);
const all = await getCaseStudies(lang);
const index = all.findIndex((c) => c.slug === slug);
const study = all[index];
if (!study) throw new Error(`no case study "${slug}" in "${lang}"`);
const next = all[(index + 1) % all.length]!;

/** Body sections in the template order (RENCANA Phase 6). `change` is left out when empty. */
type ProseKey = 'problem' | 'constraints' | 'decision' | 'result' | 'change';
const ORDER: { key: ProseKey; accent: Accent }[] = [
  { key: 'problem', accent: 'red' },
  { key: 'constraints', accent: 'none' },
  { key: 'decision', accent: 'yellow' },
  { key: 'result', accent: 'none' },
  { key: 'change', accent: 'none' },
];
const prose = ORDER.flatMap(({ key, accent }) => {
  const paras = study.sections[key];
  return paras && paras.length > 0 ? [{ key, accent, paras }] : [];
});
---

<Base
  lang={lang}
  title={`${study.title} | ${site.meta.caseStudyTitleSuffix}`}
  description={study.dek}
  alternates={{ en: workPath('en', slug), id: workPath('id', slug) }}
  shareAlt={site.meta.shareAlt}
>
  <SkipLink label={d.skipLink} />

  <header class="bar" id="top">
    <a class="name" href={homePath(lang)}>
      {site.name}
    </a>
    <LangSwitch href={workPath(other, slug)} hreflang={other} label={d.langSwitch.label} />
    <ThemeToggle labels={d.theme} />
  </header>

  <main id="main">
    <Section labelledby="title">
      <Heading level={1} id="title">
        {study.title}
      </Heading>
      <p>{study.dek}</p>
      <p class="mono">
        {d.caseStudy.role}: {study.role} · {d.caseStudy.period}: {study.period}
      </p>
      <ul class="tags" aria-label={d.caseStudy.stack}>
        {study.stack.map((s) => (
          <Tag as="li">{s}</Tag>
        ))}
      </ul>
      {study.links.length > 0 && (
        <ul class="links" aria-label={d.caseStudy.links}>
          {study.links.map((l) => (
            <li>
              <LinkArrow href={l.href} external={l.href.startsWith('https://')}>
                {l.label}
              </LinkArrow>
            </li>
          ))}
        </ul>
      )}
    </Section>

    {prose.map(({ key, accent, paras }) => (
      <Section labelledby={key} accent={accent}>
        <Heading level={2} id={key}>
          {d.caseStudy[key]}
        </Heading>
        {key === 'constraints' ? (
          <ul class="prose list">
            {paras.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        ) : (
          <div class="prose">
            {paras.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )}
      </Section>
    ))}

    {slug === 'monitoring-noc' && (
      <Section labelledby="noc" accent="green">
        <Heading level={2} id="noc">
          {d.noc.heading}
        </Heading>
        <NocDiagram lang={lang} strings={d.noc} />
      </Section>
    )}

    <Section labelledby="facts">
      <Heading level={2} id="facts">
        {d.caseStudy.facts}
      </Heading>
      <ul class="facts">
        {study.facts.map((f) => (
          <li>
            <Stat value={f.value} label={f.label} source={f.source} />
          </li>
        ))}
      </ul>
    </Section>

    <nav class="more">
      <LinkArrow href={homePath(lang)} back>
        {d.caseStudy.backHome}
      </LinkArrow>
      <LinkArrow href={workPath(lang, next.slug)}>
        {d.caseStudy.next}: {next.title}
      </LinkArrow>
    </nav>
  </main>
</Base>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4) var(--s-5);
    padding: var(--s-4) var(--gutter);
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .prose {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
    margin: 0;
  }

  .prose p {
    margin: 0;
  }

  .list {
    padding-inline-start: 1.2em;
  }

  .list li + li {
    margin-top: var(--s-2);
  }

  .links {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags,
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-6) var(--gutter);
  }
</style>
