---
/**
 * Decorative contour lines, a static SVG built at build time, aria-hidden.
 * Drawn in --contour at low opacity. Takes contour data already projected into
 * its own box; Phase 4 feeds it the Natural Earth bathymetry from chart.json.
 * Until then callers pass placeholderContours() (synthetic, flagged).
 */
import { pathData, type ContourSet } from '../lib/contours';

export interface Props {
  data: ContourSet;
  /** 'slice' covers the box (backdrop), 'meet' shows the whole set (figure) */
  fit?: 'slice' | 'meet';
  class?: string;
}

const { data, fit = 'slice', class: className } = Astro.props;
const paths = data.contours.map((c) => ({ d: pathData(c.lines), major: c.major ?? false }));
---

<svg
  class:list={['contour-backdrop', className]}
  viewBox={`0 0 ${data.width} ${data.height}`}
  preserveAspectRatio={`xMidYMid ${fit}`}
  aria-hidden="true"
  focusable="false"
  data-synthetic={data.synthetic ? 'true' : undefined}
>
  {paths.map((p) => p.d && <path class:list={{ major: p.major }} d={p.d} />)}
</svg>

<style>
  .contour-backdrop {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    fill: none;
    stroke: var(--contour);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: var(--contour-opacity);
  }

  .contour-backdrop path {
    vector-effect: non-scaling-stroke;
  }

  .contour-backdrop .major {
    stroke-width: 1.75;
  }

  @media (forced-colors: active) {
    .contour-backdrop {
      display: none;
    }
  }
</style>
