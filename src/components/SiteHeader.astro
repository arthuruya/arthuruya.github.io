---
/**
 * Page header: name (home link), nav anchors, language link, theme switch. Not sticky.
 * Under 40 rem the nav sits in a native <details> disclosure; from 40 rem it is always
 * listed. Without JS the disclosure still works, because it is plain HTML.
 */
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Lang } from './types';

export interface Props {
  name: string;
  homeHref: string;
  nav: { href: string; label: string }[];
  menuLabel: string;
  navLabel: string;
  lang: { href: string; hreflang: Lang; label: string };
  theme: {
    toNight: string;
    toDay: string;
    night: string;
    day: string;
  };
}

const { name, homeHref, nav, menuLabel, navLabel, lang, theme } = Astro.props;
---

<header class="bar" id="top">
  <a class="name" href={homeHref}>
    {name}
  </a>
  <details class="menu">
    <summary>{menuLabel}</summary>
    <nav aria-label={navLabel}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
  <div class="tools">
    <LangSwitch href={lang.href} hreflang={lang.hreflang} label={lang.label} />
    <ThemeToggle labels={theme} />
  </div>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--s-4) var(--gutter);
  }

  .name {
    flex: 1 1 auto;
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 600;
    text-decoration: none;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
  }

  summary {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem; /* 44 px target */
    padding-inline: var(--s-3);
    border: var(--rule) solid var(--ink-2);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    border-color: var(--ink);
  }

  nav ul {
    display: grid;
    gap: var(--s-1);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
  }

  @media (min-width: 40rem) {
    /* Where ::details-content exists the nav is always shown and the button goes away.
       Elsewhere the disclosure stays, so the links are still reachable. */
    @supports selector(::details-content) {
      .menu summary {
        display: none;
      }

      .menu::details-content {
        content-visibility: visible;
      }

      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-1) var(--s-5);
        margin: 0;
      }
    }
  }

  @media (forced-colors: active) {
    summary {
      border-color: ButtonText;
    }
  }
</style>
