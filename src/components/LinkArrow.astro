---
/**
 * A link with a mono arrow. Arrows are set in IBM Plex Mono because Atkinson and
 * Newsreader have no glyph for them (scripts/build-fonts.md). Opens in the same tab.
 */
export interface Props {
  href: string;
  back?: boolean;
  external?: boolean;
  hreflang?: string;
  lang?: string;
}

const { href, back = false, external = false, hreflang, lang } = Astro.props;
---

<a
  class:list={['link-arrow', { back }]}
  href={href}
  hreflang={hreflang}
  lang={lang}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {back && (
    <span class="arrow" aria-hidden="true">
      ←
    </span>
  )}
  <span class="text">
    <slot />
  </span>
  {!back && (
    <span class="arrow" aria-hidden="true">
      →
    </span>
  )}
</a>

<style>
  .link-arrow {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    text-decoration: none;
  }

  .text {
    text-decoration-line: underline;
    text-decoration-color: var(--ink-2);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .arrow {
    font-family: var(--font-mono);
    transition: transform var(--dur) var(--ease);
  }

  .link-arrow:hover .text {
    text-decoration-thickness: 2px;
    text-decoration-color: currentcolor;
  }

  .link-arrow:hover .arrow {
    transform: translateX(0.15em);
  }

  .link-arrow.back:hover .arrow {
    transform: translateX(-0.15em);
  }
</style>
