{
  "name": "arthuruya.github.io",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:colours": "node scripts/check-colours.mjs",
    "check:sanitize": "node scripts/check-sanitize.mjs",
    "check:astro": "astro check",
    "check:html": "node scripts/check-html.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "urls:write": "node scripts/check-urls.mjs --write",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:static": "npm run check:colours && npm run check:sanitize && npm run check:astro && npm run lint && npm run format:check && npm run test",
    "check": "npm run check:static && npm run build && npm run check:html && npm run check:urls"
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
